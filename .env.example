# ==========================================
# BALLEGH AI — CONFIGURATION DES VARIABLES D'ENVIRONNEMENT (PHASE 2)
# ==========================================
# Ce fichier sert d'exemple et ne contient AUCUN secret réel.
# Copiez ce fichier vers .env.local et renseignez vos identifiants réels.

# 1. Base de données PostgreSQL / Supabase
# Format standard PostgreSQL local :
# DATABASE_URL="postgresql://postgres:votre_mot_de_passe@localhost:5432/ballegh_ai?schema=public"
# Format Supabase (Connection Pooling Port 6543 recommandé pour Serverless) :
# DATABASE_URL="postgresql://postgres.[REF_PROJET]:[MOT_DE_PASSE]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL="postgresql://ballegh_user:placeholder_password@localhost:5432/ballegh_ai?schema=public"

# 2. Authentification des sessions JWT (HS256)
# Clé secrète de signature des sessions JWT (au moins 32 caractères aléatoires)
# Commande de génération : openssl rand -base64 32
AUTH_SECRET="votre_cle_secrete_aleatoire_au_moins_32_caracteres"
NEXTAUTH_URL="http://localhost:3000"

# 3. Moteur IA — Google Gemini (Optionnel — Vision & Triage en ligne)
# Si non renseigné, le système utilise automatiquement le modèle heuristique certifié local
GEMINI_API_KEY="votre_cle_api_google_gemini_ici"

# 4. Service de Transmission des Courriels Officiels (Optionnel)
# Si non renseigné, le système fonctionne en mode Brouillon officiel avec piste d'audit
RESEND_API_KEY="re_votre_cle_api_resend_ici"
# Ou via serveur SMTP standard :
# SMTP_HOST="smtp.commune-tunis.gov.tn"
# SMTP_PORT="587"
# SMTP_USER="notifications@commune-tunis.gov.tn"
# SMTP_PASSWORD="votre_mot_de_passe_smtp"

# 5. Sécurité d'environnement
# En production (NODE_ENV=production), le basculement démo est bloqué par défaut.
# ALLOW_DEMO_SWITCH="false"
