# ==============================================================================
# BALLEGH AI (بلّغ) — CONFIGURATION DES VARIABLES D'ENVIRONNEMENT DE PRODUCTION
# ==============================================================================
# Ce fichier sert de référence documentaire et ne contient AUCUN secret réel.
# Copiez ce fichier vers .env.local et renseignez vos clés réelles.
# Ne JAMAIS committer de fichier .env.local contenant des identifiants sensibles.

# ------------------------------------------------------------------------------
# 1. Base de données PostgreSQL / Supabase
# ------------------------------------------------------------------------------
# Format Supabase (Recommandé avec Pooler Transaction IPv4 Port 5432 / 6543) :
# DATABASE_URL="postgresql://postgres.[REF_PROJET]:[MOT_DE_PASSE]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
# Format PostgreSQL direct ou local :
DATABASE_URL="postgresql://postgres:votre_mot_de_passe_robuste@localhost:5432/ballegh_ai?schema=public"

# ------------------------------------------------------------------------------
# 2. Authentification & Sécurité des Sessions (JWT HS256)
# ------------------------------------------------------------------------------
# Clé secrète de signature cryptographique (au moins 32 caractères aléatoires)
# Génération : openssl rand -base64 32
AUTH_SECRET="votre_cle_secrete_aleatoire_au_moins_32_caracteres"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Stockage Privé des Photos d'Incidents — Supabase Storage
# ------------------------------------------------------------------------------
# Bucket privé : 'ballegh-reports' (taille max: 5 Mo, types: JPEG, PNG, WebP)
# La clé de rôle de service (service_role) est réservée au serveur et JAMAIS exposée au client.
NEXT_PUBLIC_SUPABASE_URL="https://votre-projet.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="votre_supabase_service_role_secret_key"

# ------------------------------------------------------------------------------
# 4. Intelligence Artificielle Multimodale — Google Gemini Vision
# ------------------------------------------------------------------------------
# Utilisé pour l'analyse visuelle, la sévérité et la rédaction de brouillons d'emails.
# En cas d'absence ou d'épuisement du quota, un fallback heuristique certifié prend le relais.
GEMINI_API_KEY="votre_cle_api_google_gemini_ici"

# ------------------------------------------------------------------------------
# 5. Service d'Expédition des Courriels Officiels Municipaux
# ------------------------------------------------------------------------------
# Règle stricte : Aucune saisine officielle n'est envoyée sans validation humaine préalable.
# En l'absence de configuration, le statut reste consigné comme PENDING_SMTP_CONFIG.
#
# Option A : Passerelle Resend API (Recommandé pour délivrabilité DNS et métriques)
RESEND_API_KEY="re_votre_cle_api_resend_ici"
EMAIL_FROM="Ballegh AI <notifications@ballegh.tn>"

# Configuration DNS requise pour un domaine vérifié chez votre registrar (ex: ballegh.tn) :
# 1. DKIM (TXT) : resend._domainkey.ballegh.tn  -> "k=rsa; p=[CLE_PUBLIQUE_RESEND]"
# 2. SPF (TXT)  : ballegh.tn                   -> "v=spf1 include:resend.com ~all"
# 3. DMARC (TXT): _dmarc.ballegh.tn            -> "v=DMARC1; p=none; rua=mailto:dmarc@ballegh.tn"
# 4. MX         : send.ballegh.tn              -> feedback-smtp.eu-west-1.amazonses.com (priorité 10)

# Option B : Serveur SMTP Institutionnel (Alternative Passerelle Municipale / FAI)
# SMTP_HOST="smtp.commune-tunis.gov.tn"
# SMTP_PORT="587"
# SMTP_USER="notifications@commune-tunis.gov.tn"
# SMTP_PASS="votre_mot_de_passe_smtp"
# SMTP_FROM="Ballegh AI <notifications@commune-tunis.gov.tn>"

# ------------------------------------------------------------------------------
# 6. Contrôles de Production & Démonstration
# ------------------------------------------------------------------------------
# En production, désactiver le commutateur rapide de démonstration (forcer à "false")
ALLOW_DEMO_SWITCH="false"
NODE_ENV="production"
